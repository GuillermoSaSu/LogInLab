@model LogInLab.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Recuperar contraseña";
}

<h1>
    Forgot your password??
</h1>

<p>Enter your email, and if you have an account with us, we will send you a link to reset your password.</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="ForgotPassword" method="post">
    <div class="form-group mb-3">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Send reset password link</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}